{
	"configurations": [
		{
			"name": "C/C++: Debug active file",
			"type": "cppdbg",
			"request": "launch",
			"program": "${fileDirname}/${fileBasenameNoExtension}",
			"args": [],
			"stopAtEntry": false,
			"cwd": "${fileDirname}",
			"environment": [],
			"externalConsole": true,
			"MIMode": "lldb",
			"preLaunchTask": "Compile and Run C++",
			"postDebugTask": "Remove C++ Executable"
		},
		{
			"name": "Java: Debug active file",
			"type": "java",
			"request": "launch",
			"mainClass": "${fileBasenameNoExtension}",
			"args": [
				"<",
				"${workspaceFolder}/.miscellaneous/input.txt",
				">",
				"${workspaceFolder}/.miscellaneous/output.txt"
			],
			"cwd": "${fileDirname}",
			"preLaunchTask": "Compile and Run Java",
			"postDebugTask": "Remove Java Class"
		}
	],
	"version": "2.0.0"
}
